;&quot;&gt;_tools&lt;/span&gt;[&lt;span class=&quot;pl-s1&quot; style=&quot;box-sizing: border-box;&quot;&gt;tool&lt;/span&gt;.&lt;span class=&quot;pl-c1&quot; style=&quot;box-sizing: border-box; color: rgb(5, 80, 174);&quot;&gt;name&lt;/span&gt;] &lt;span class=&quot;pl-c1&quot; style=&quot;box-sizing: border-box; color: rgb(5, 80, 174);&quot;&gt;=&lt;/span&gt; &lt;span class=&quot;pl-s1&quot; style=&quot;box-sizing: border-box;&quot;&gt;tool&lt;/span&gt;&lt;br&gt;        &lt;span class=&quot;pl-en&quot; style=&quot;box-sizing: border-box; color: rgb(102, 57, 186);&quot;&gt;print&lt;/span&gt;(&lt;span class=&quot;pl-s&quot; style=&quot;box-sizing: border-box; color: rgb(10, 48, 105);&quot;&gt;f&quot;✅ 工具 &#39;&lt;span class=&quot;pl-s1&quot; style=&quot;box-sizing: border-box; color: rgb(31, 35, 40);&quot;&gt;&lt;span class=&quot;pl-kos&quot; style=&quot;box-sizing: border-box;&quot;&gt;{&lt;/span&gt;&lt;span class=&quot;pl-s1&quot; style=&quot;box-sizing: border-box;&quot;&gt;tool&lt;/span&gt;.&lt;span class=&quot;pl-c1&quot; style=&quot;box-sizing: border-box; color: rgb(5, 80, 174);&quot;&gt;name&lt;/span&gt;&lt;span class=&quot;pl-kos&quot; style=&quot;box-sizing: border-box;&quot;&gt;}&lt;/span&gt;&lt;/span&gt;&#39; 已注册。&quot;&lt;/span&gt;)&lt;br&gt;        &lt;br&gt;    &lt;span class=&quot;pl-k&quot; style=&quot;box-sizing: border-box; color: rgb(207, 34, 46);&quot;&gt;def&lt;/span&gt; &lt;span class=&quot;pl-en&quot; style=&quot;box-sizing: border-box; color: rgb(102, 57, 186);&quot;&gt;register_function&lt;/span&gt;(&lt;span class=&quot;pl-s1&quot; style=&quot;box-sizing: border-box;&quot;&gt;self&lt;/span&gt;, &lt;span class=&quot;pl-s1&quot; style=&quot;box-sizing: border-box;&quot;&gt;name&lt;/span&gt;: &lt;span class=&quot;pl-smi&quot; style=&quot;box-sizing: border-box;&quot;&gt;str&lt;/span&gt;, &lt;span class=&quot;pl-s1&quot; style=&quot;box-sizing: border-box;&quot;&gt;description&lt;/span&gt;: &lt;span class=&quot;pl-smi&quot; style=&quot;box-siz