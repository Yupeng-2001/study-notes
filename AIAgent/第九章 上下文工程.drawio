        <mxCell id="tNFW55iZ728InIklxEnu-11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=7;" value="&lt;pre style=&quot;box-sizing: border-box; font-family: &amp;quot;Monaspace Neon&amp;quot;, ui-monospace, SFMono-Regular, &amp;quot;SF Mono&amp;quot;, Menlo, Consolas, &amp;quot;Liberation Mono&amp;quot;, monospace; font-size: 13.6px; margin-top: 0px; margin-bottom: 0px; tab-size: 4; overflow-wrap: normal; padding: 16px; color: rgb(31, 35, 40); background-color: rgb(246, 248, 250); border-radius: 6px; line-height: 1.45; overflow: auto; word-break: normal; min-height: 52px; text-align: start;&quot;&gt;&lt;span class=&quot;pl-k&quot; style=&quot;box-sizing: border-box; color: rgb(207, 34, 46);&quot;&gt;def&lt;/span&gt; &lt;span class=&quot;pl-en&quot; style=&quot;box-sizing: border-box; color: rgb(102, 57, 186);&quot;&gt;_calculate_recency&lt;/span&gt;(&lt;span class=&quot;pl-s1&quot; style=&quot;box-sizing: border-box;&quot;&gt;self&lt;/span&gt;, &lt;span class=&quot;pl-s1&quot; style=&quot;box-sizing: border-box;&quot;&gt;timestamp&lt;/span&gt;: &lt;span class=&quot;pl-smi&quot; style=&quot;box-sizing: border-box;&quot;&gt;datetime&lt;/span&gt;) &lt;span class=&quot;pl-c1&quot; style=&quot;box-sizing: border-box; color: rgb(5, 80, 174);&quot;&gt;-&amp;gt;&lt;/span&gt; &lt;span class=&quot;pl-smi&quot; style=&quot;box-sizing: border-box;&quot;&gt;float&lt;/span&gt;:&lt;br/&gt;    &lt;span class=&quot;pl-s&quot; style=&quot;box-sizing: border-box; color: rgb(10, 48, 105);&quot;&gt;&quot;&quot;&quot;计算时间近因性分数&lt;/span&gt;&lt;br/&gt;&lt;span class=&quot;pl-s&quot; style=&quot;box-sizing: border-box; color: rgb(10, 48, 105);&quot;&gt;&lt;/span&gt;&lt;br/&gt;&lt;span class=&quot;pl-s&quot; style=&quot;box-sizing: border-box; color: rgb(10, 48, 105);&quot;&gt;    使用指数衰减模型,24小时内保持高分,之后逐渐衰减。&lt;br&gt;&lt;pre style=&quot;box-sizing: border-box; font-family: &amp;quot;Monaspace Neon&amp;quot;, ui-monospace, SFMono-Regular, &amp;quot;SF Mono&amp;quot;, Menlo, Consolas, &amp;quot;Liberation Mono&amp;quot;, monospace; margin-top: 0px; margin-bottom: 0px; tab-size: 4; overflow-wrap: normal; padding: 16px; color: rgb(31, 35, 40); border-radius: 6px; line-height: 1.45; overflow: auto; word-break: normal; min-height: 52px;&quot;&gt;&lt;span class=&quot;pl-s&quot; style=&quot;box-sizing: border-box; color: rgb(10, 48, 105);&quot;&gt;        float: 新近性分数(0.0-1.0)&lt;/span&gt;&lt;br/&gt;&lt;span class=&quot;pl-s&quot; style=&quot;box-sizing: border-box; color: rgb(10, 48, 105);&quot;&gt;    &quot;&quot;&quot;&lt;/span&gt;&lt;/pre&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;......&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;recency_score&lt;span style=&quot;color: rgb(31, 35, 40); white-space: normal;&quot;&gt; &lt;/span&gt;&lt;span class=&quot;pl-c1&quot; style=&quot;white-space: normal; box-sizing: border-box; color: rgb(5, 80, 174);&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;color: rgb(31, 35, 40); white-space: normal;&quot;&gt; &lt;/span&gt;&lt;span class=&quot;pl-s1&quot; style=&quot;color: rgb(31, 35, 40); white-space: normal; box-sizing: border-box;&quot;&gt;math&lt;/span&gt;&lt;span style=&quot;color: rgb(31, 35, 40); white-space: normal;&quot;&gt;.&lt;/span&gt;&lt;span class=&quot;pl-c1&quot; style=&quot;white-space: normal; box-sizing: border-box; color: rgb(5, 80, 174);&quot;&gt;exp&lt;/span&gt;&lt;span style=&quot;color: rgb(31, 35, 40); white-space: normal;&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;pl-c1&quot; style=&quot;white-space: normal; box-sizing: border-box; color: rgb(5, 80, 174);&quot;&gt;-&lt;/span&gt;&lt;span class=&quot;pl-s1&quot; style=&quot;color: rgb(31, 35, 40); white-space: normal; box-sizing: border-box;&quot;&gt;decay_factor&lt;/span&gt;&lt;span style=&quot;color: rgb(31, 35, 40); white-space: normal;&quot;&gt; &lt;/span&gt;&lt;span class=&quot;pl-c1&quot; style=&quot;white-space: normal; box-sizing: border-box; color: rgb(5, 80, 174);&quot;&gt;*&lt;/span&gt;&lt;span style=&quot;color: rgb(31, 35, 40); white-space: normal;&quot;&gt; &lt;/span&gt;&lt;span class=&quot;pl-s1&quot; style=&quot;color: rgb(31, 35, 40); white-space: normal; box-sizing: border-box;&quot;&gt;age_hours&lt;/span&gt;&lt;span style=&quot;color: rgb(31, 35, 40); white-space: normal;&quot;&gt; &lt;/span&gt;&lt;span class=&quot;pl-c1&quot; style=&quot;white-space: normal; box-sizing: border-box; color: rgb(5, 80, 174);&quot;&gt;/&lt;/span&gt;&lt;span style=&quot;color: rgb(31, 35, 40); white-space: normal;&quot;&gt; &lt;/span&gt;&lt;span class=&quot;pl-c1&quot; style=&quot;white-space: normal; box-sizing: border-box; color: rgb(5, 80, 174);&quot;&gt;24&lt;/span&gt;&lt;span style=&quot;color: rgb(31, 35, 40); white-space: normal;&quot;&gt;)&lt;/span&gt;&lt;pre style=&quot;box-sizing: border-box; font-family: &amp;quot;Monaspace Neon&amp;quot;, ui-monospace, SFMono-Regular, &amp;quot;SF Mono&amp;quot;, Menlo, Consolas, &amp;quot;Liberation Mono&amp;quot;, monospace; margin-top: 0px; margin-bottom: 0px; tab-size: 4; overflow-wrap: normal; padding: 16px; color: rgb(31, 35, 40); border-radius: 6px; line-height: 1.45; overflow: auto; word-break: normal; min-height: 52px;&quot;&gt;  ......&lt;/pre&gt;&lt;/span&gt;&lt;/pre&gt;" vertex="1">
