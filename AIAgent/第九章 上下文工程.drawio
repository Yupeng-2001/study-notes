 style=&quot;box-sizing: border-box;&quot;&gt;all_notes&lt;/span&gt; &lt;span class=&quot;pl-c1&quot; style=&quot;box-sizing: border-box; color: rgb(5, 80, 174);&quot;&gt;=&lt;/span&gt; {&lt;span class=&quot;pl-s1&quot; style=&quot;box-sizing: border-box;&quot;&gt;note&lt;/span&gt;[&lt;span class=&quot;pl-s&quot; style=&quot;box-sizing: border-box; color: rgb(10, 48, 105);&quot;&gt;&#39;note_id&#39;&lt;/span&gt;]: &lt;span class=&quot;pl-s1&quot; style=&quot;box-sizing: border-box;&quot;&gt;note&lt;/span&gt; &lt;span class=&quot;pl-k&quot; style=&quot;box-sizing: border-box; color: rgb(207, 34, 46);&quot;&gt;for&lt;/span&gt; &lt;span class=&quot;pl-s1&quot; style=&quot;box-sizing: border-box;&quot;&gt;note&lt;/span&gt; &lt;span class=&quot;pl-c1&quot; style=&quot;box-sizing: border-box; color: rgb(5, 80, 174);&quot;&gt;in&lt;/span&gt; &lt;span class=&quot;pl-s1&quot; style=&quot;box-sizing: border-box;&quot;&gt;blockers&lt;/span&gt; &lt;span class=&quot;pl-c1&quot; style=&quot;box-sizing: border-box; color: rgb(5, 80, 174);&quot;&gt;+&lt;/span&gt; &lt;span class=&quot;pl-s1&quot; style=&quot;box-sizing: border-box;&quot;&gt;search_results&lt;/span&gt;}&#xa;            &lt;span class=&quot;pl-k&quot; style=&quot;box-sizing: border-box; color: rgb(207, 34, 46);&quot;&gt;return&lt;/span&gt; &lt;span class=&quot;pl-en&quot; style=&quot;box-sizing: border-box; color: rgb(102, 57, 186);&quot;&gt;list&lt;/span&gt;(&lt;span class=&quot;pl-s1&quot; style=&quot;box-sizing: border-box;&quot;&gt;all_notes&lt;/span&gt;.&lt;span class=&quot;pl-c1&quot; style=&quot;box-sizing: border-box; color: rgb(5, 80, 174);&quot;&gt;values&lt;/span&gt;())[:&lt;span class=&quot;pl-s1&quot; style=&quot;box-sizing: border-box;&quot;&gt;limit&lt;/span&gt;]&#xa;&#xa;        &lt;span class=&quot;pl-k&quot; style=&quot;box-sizing: border-box; color: rgb(207, 34, 46);&quot;&gt;except&lt;/span&gt; &lt;span class=&quot;pl-v&quot; style=&quot;box-sizing: border-box; color: rgb(149, 56, 0);&quot;&gt;Exce