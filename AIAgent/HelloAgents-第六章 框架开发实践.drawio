;&#xa;    ],&#xa;    &lt;span class=&quot;pl-s1&quot; style=&quot;box-sizing: border-box;&quot;&gt;termination_condition&lt;/span&gt;&lt;span class=&quot;pl-c1&quot; style=&quot;box-sizing: border-box; color: rgb(5, 80, 174);&quot;&gt;=&lt;/span&gt;&lt;span class=&quot;pl-en&quot; style=&quot;box-sizing: border-box; color: rgb(102, 57, 186);&quot;&gt;TextMentionTermination&lt;/span&gt;(&lt;span class=&quot;pl-s&quot; style=&quot;box-sizing: border-box; color: rgb(10, 48, 105);&quot;&gt;&quot;TERMINATE&quot;&lt;/span&gt;),&#xa;    &lt;span class=&quot;pl-s1&quot; style=&quot;box-sizing: border-box;&quot;&gt;max_turns&lt;/span&gt;&lt;span class=&quot;pl-c1&quot; style=&quot;box-sizing: border-box; color: rgb(5, 80, 174);&quot;&gt;=&lt;/span&gt;&lt;span class=&quot;pl-c1&quot; style=&quot;box-sizing: border-box; color: rgb(5, 80, 174);&quot;&gt;20&lt;/span&gt;,&#xa;)&lt;/pre&gt;&#xa;&#xa;" vertex="1">
