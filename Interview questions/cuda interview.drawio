        <mxCell id="vpTy94eq_YALo0UENetr-99" edge="1" parent="1" source="vpTy94eq_YALo0UENetr-80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="vpTy94eq_YALo0UENetr-95">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vpTy94eq_YALo0UENetr-80" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;h3 id=&quot;h_678602674_13&quot; data-into-catalog-status=&quot;&quot; style=&quot;font-variant-numeric: inherit; font-variant-east-asian: inherit; font-variant-alternates: inherit; font-variant-position: inherit; font-variant-emoji: inherit; font-stretch: inherit; font-size: 1.1em; line-height: 1.5; font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Helvetica Neue&amp;quot;, &amp;quot;PingFang SC&amp;quot;, &amp;quot;Microsoft YaHei&amp;quot;, &amp;quot;Source Han Sans SC&amp;quot;, &amp;quot;Noto Sans CJK SC&amp;quot;, &amp;quot;WenQuanYi Micro Hei&amp;quot;, &amp;quot;MiSans L3&amp;quot;, &amp;quot;Segoe UI&amp;quot;, sans-serif; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-language-override: inherit; margin: calc(1.90909em) 0px calc(1.27273em); clear: left; color: rgb(25, 27, 31); text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;TensorCore 的加速原理&lt;/h3&gt;" vertex="1">
          <mxGeometry height="60" width="200" x="560" y="2200" as="geometry" />
        </mxCell>
        <mxCell id="vpTy94eq_YALo0UENetr-85" edge="1" parent="1" source="vpTy94eq_YALo0UENetr-81" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="vpTy94eq_YALo0UENetr-84">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vpTy94eq_YALo0UENetr-81" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;color: rgb(25, 27, 31); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Helvetica Neue&amp;quot;, &amp;quot;PingFang SC&amp;quot;, &amp;quot;Microsoft YaHei&amp;quot;, &amp;quot;Source Han Sans SC&amp;quot;, &amp;quot;Noto Sans CJK SC&amp;quot;, &amp;quot;WenQuanYi Micro Hei&amp;quot;, &amp;quot;MiSans L3&amp;quot;, &amp;quot;Segoe UI&amp;quot;, sans-serif; font-size: medium; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;与 CUDA Core 相比，它能够在一个时钟周期内执行多个操作&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="470" x="1177.5" y="2200" as="geometry" />
        </mxCell>
        <mxCell id="vpTy94eq_YALo0UENetr-87" edge="1" parent="1" source="vpTy94eq_YALo0UENetr-83" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="vpTy94eq_YALo0UENetr-86">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vpTy94eq_YALo0UENetr-83" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;color: rgb(25, 27, 31); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Helvetica Neue&amp;quot;, &amp;quot;PingFang SC&amp;quot;, &amp;quot;Microsoft YaHei&amp;quot;, &amp;quot;Source Han Sans SC&amp;quot;, &amp;quot;Noto Sans CJK SC&amp;quot;, &amp;quot;WenQuanYi Micro Hei&amp;quot;, &amp;quot;MiSans L3&amp;quot;, &amp;quot;Segoe UI&amp;quot;, sans-serif; font-size: medium; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;加速也基于混合精度矩阵乘法&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="270" x="1177.5" y="2300" as="geometry" />
        </mxCell>
        <mxCell id="vpTy94eq_YALo0UENetr-84" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;color: rgb(25, 27, 31); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Helvetica Neue&amp;quot;, &amp;quot;PingFang SC&amp;quot;, &amp;quot;Microsoft YaHei&amp;quot;, &amp;quot;Source Han Sans SC&amp;quot;, &amp;quot;Noto Sans CJK SC&amp;quot;, &amp;quot;WenQuanYi Micro Hei&amp;quot;, &amp;quot;MiSans L3&amp;quot;, &amp;quot;Segoe UI&amp;quot;, sans-serif; font-size: medium; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;可以同时对两个 4×4 的 FP16 张量进行矩阵乘积计算，并将结果累加到另一个 4×4 的张量上（即 D = A * B + C）&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="860" x="1767.5" y="2200" as="geometry" />
        </mxCell>
        <mxCell id="vpTy94eq_YALo0UENetr-86" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;color: rgb(25, 27, 31); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Helvetica Neue&amp;quot;, &amp;quot;PingFang SC&amp;quot;, &amp;quot;Microsoft YaHei&amp;quot;, &amp;quot;Source Han Sans SC&amp;quot;, &amp;quot;Noto Sans CJK SC&amp;quot;, &amp;quot;WenQuanYi Micro Hei&amp;quot;, &amp;quot;MiSans L3&amp;quot;, &amp;quot;Segoe UI&amp;quot;, sans-serif; font-size: medium; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;底层硬件算子层面，使用半精度（FP16）作为输入和输出，使用全精度（FP32）进行中间结果计算&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="770" x="1527.5" y="2300" as="geometry" />
        </mxCell>
        <mxCell id="vpTy94eq_YALo0UENetr-89" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;color: rgb(25, 27, 31); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Helvetica Neue&amp;quot;, &amp;quot;PingFang SC&amp;quot;, &amp;quot;Microsoft YaHei&amp;quot;, &amp;quot;Source Han Sans SC&amp;quot;, &amp;quot;Noto Sans CJK SC&amp;quot;, &amp;quot;WenQuanYi Micro Hei&amp;quot;, &amp;quot;MiSans L3&amp;quot;, &amp;quot;Segoe UI&amp;quot;, sans-serif; font-size: medium; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;通过硬件上的特殊设计，Tensor Core 理论上可以实现 8 倍于 FP32 Core 的计算吞吐量（Volta 和 Turing 架构）&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="850" x="1177.5" y="2400" as="geometry" />
        </mxCell>
        <mxCell id="vpTy94eq_YALo0UENetr-94" edge="1" parent="1" source="vpTy94eq_YALo0UENetr-91" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="vpTy94eq_YALo0UENetr-93">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vpTy94eq_YALo0UENetr-91" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;color: rgb(25, 27, 31); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Helvetica Neue&amp;quot;, &amp;quot;PingFang SC&amp;quot;, &amp;quot;Microsoft YaHei&amp;quot;, &amp;quot;Source Han Sans SC&amp;quot;, &amp;quot;Noto Sans CJK SC&amp;quot;, &amp;quot;WenQuanYi Micro Hei&amp;quot;, &amp;quot;MiSans L3&amp;quot;, &amp;quot;Segoe UI&amp;quot;, sans-serif; font-size: medium; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;CUDA Core 针对各种并行计算任务进行了优化，更适合于通用并行计算任务&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="590" x="920" y="2490" as="geometry" />
        </mxCell>
        <mxCell id="vpTy94eq_YALo0UENetr-93" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;font-weight: 600; color: rgb(25, 27, 31); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Helvetica Neue&amp;quot;, &amp;quot;PingFang SC&amp;quot;, &amp;quot;Microsoft YaHei&amp;quot;, &amp;quot;Source Han Sans SC&amp;quot;, &amp;quot;Noto Sans CJK SC&amp;quot;, &amp;quot;WenQuanYi Micro Hei&amp;quot;, &amp;quot;MiSans L3&amp;quot;, &amp;quot;Segoe UI&amp;quot;, sans-serif; font-size: medium; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;深度学习任务其不仅仅是矩阵运算，还有很多的并行计算，这就看瓶颈在哪里了&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="635" x="1585" y="2490" as="geometry" />
        </mxCell>
        <mxCell id="vpTy94eq_YALo0UENetr-95" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;font-weight: 600; color: rgb(25, 27, 31); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Helvetica Neue&amp;quot;, &amp;quot;PingFang SC&amp;quot;, &amp;quot;Microsoft YaHei&amp;quot;, &amp;quot;Source Han Sans SC&amp;quot;, &amp;quot;Noto Sans CJK SC&amp;quot;, &amp;quot;WenQuanYi Micro Hei&amp;quot;, &amp;quot;MiSans L3&amp;quot;, &amp;quot;Segoe UI&amp;quot;, sans-serif; font-size: medium; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;Tensor Core 的使用是有些限制的，对于 GEMM 计算其效果很好，其次其输入和输出数据类型需要是半精度或单精度，矩阵的维度最好是 8 的倍数&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="540" x="920" y="2580" as="geometry" />
        </mxCell>
        <mxCell id="vpTy94eq_YALo0UENetr-97" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&#xa;&lt;span style=&quot;color: rgb(25, 27, 31); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Helvetica Neue&amp;quot;, &amp;quot;PingFang SC&amp;quot;, &amp;quot;Microsoft YaHei&amp;quot;, &amp;quot;Source Han Sans SC&amp;quot;, &amp;quot;Noto Sans CJK SC&amp;quot;, &amp;quot;WenQuanYi Micro Hei&amp;quot;, &amp;quot;MiSans L3&amp;quot;, &amp;quot;Segoe UI&amp;quot;, sans-serif; font-size: medium; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;加速&lt;/span&gt;&#xa;&#xa;" vertex="1">
          <mxGeometry height="60" width="120" x="920" y="2200" as="geometry" />
        </mxCell>
        <mxCell id="KgB6VFAsoXN8Tu3kynN7-7" edge="1" parent="1" source="KgB6VFAsoXN8Tu3kynN7-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="KgB6VFAsoXN8Tu3kynN7-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="KgB6VFAsoXN8Tu3kynN7-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;h3 id=&quot;h_678602674_14&quot; data-into-catalog-status=&quot;&quot; style=&quot;font-variant-numeric: inherit; font-variant-east-asian: inherit; font-variant-alternates: inherit; font-variant-position: inherit; font-variant-emoji: inherit; font-stretch: inherit; font-size: 1.1em; line-height: 1.5; font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Helvetica Neue&amp;quot;, &amp;quot;PingFang SC&amp;quot;, &amp;quot;Microsoft YaHei&amp;quot;, &amp;quot;Source Han Sans SC&amp;quot;, &amp;quot;Noto Sans CJK SC&amp;quot;, &amp;quot;WenQuanYi Micro Hei&amp;quot;, &amp;quot;MiSans L3&amp;quot;, &amp;quot;Segoe UI&amp;quot;, sans-serif; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-language-override: inherit; margin: calc(1.90909em) 0px calc(1.27273em); clear: left; color: rgb(25, 27, 31); text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;MPI，OpenMP 以及 CUDA 各自适用的加速场景。&lt;/h3&gt;" vertex="1">
          <mxGeometry height="60" width="330" x="2720" y="220" as="geometry" />
        </mxCell>
