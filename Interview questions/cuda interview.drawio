        </mxCell>
        <mxCell id="vpTy94eq_YALo0UENetr-72" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;color: rgb(25, 27, 31); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Helvetica Neue&amp;quot;, &amp;quot;PingFang SC&amp;quot;, &amp;quot;Microsoft YaHei&amp;quot;, &amp;quot;Source Han Sans SC&amp;quot;, &amp;quot;Noto Sans CJK SC&amp;quot;, &amp;quot;WenQuanYi Micro Hei&amp;quot;, &amp;quot;MiSans L3&amp;quot;, &amp;quot;Segoe UI&amp;quot;, sans-serif; font-size: medium; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;格式，其具体位数如下&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="230" x="920" y="1970" as="geometry" />
        </mxCell>
        <mxCell id="vpTy94eq_YALo0UENetr-74" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;ul style=&quot;list-style: none; margin: 1.4em 0px; padding: 0px; width: 653.993px; color: rgb(25, 27, 31); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Helvetica Neue&amp;quot;, &amp;quot;PingFang SC&amp;quot;, &amp;quot;Microsoft YaHei&amp;quot;, &amp;quot;Source Han Sans SC&amp;quot;, &amp;quot;Noto Sans CJK SC&amp;quot;, &amp;quot;WenQuanYi Micro Hei&amp;quot;, &amp;quot;MiSans L3&amp;quot;, &amp;quot;Segoe UI&amp;quot;, sans-serif; font-size: medium; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;&lt;li data-pid=&quot;Vk8nN5je&quot; style=&quot;list-style: none; display: table; width: 653.993px;&quot;&gt;1 位符号位：用于表示正负号。&lt;/li&gt;&lt;li data-pid=&quot;DPsSYo7K&quot; style=&quot;list-style: none; display: table; width: 653.993px;&quot;&gt;5 位指数位：用于表示指数部分，取值范围为-14 至 15（实际上是通过偏移值来表示，即真实的指数值减去 15）。&lt;/li&gt;&lt;li data-pid=&quot;_q4sNIKt&quot; style=&quot;list-style: none; display: table; width: 653.993px;&quot;&gt;10 位尾数位：用于表示尾数部分。&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="110" width="690" x="1270" y="1970" as="geometry" />
        </mxCell>
        <mxCell id="vpTy94eq_YALo0UENetr-76" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;color: rgb(25, 27, 31); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Helvetica Neue&amp;quot;, &amp;quot;PingFang SC&amp;quot;, &amp;quot;Microsoft YaHei&amp;quot;, &amp;quot;Source Han Sans SC&amp;quot;, &amp;quot;Noto Sans CJK SC&amp;quot;, &amp;quot;WenQuanYi Micro Hei&amp;quot;, &amp;quot;MiSans L3&amp;quot;, &amp;quot;Segoe UI&amp;quot;, sans-serif; font-size: medium; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;相对float32&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-weight: 600; color: rgb(25, 27, 31); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Helvetica Neue&amp;quot;, &amp;quot;PingFang SC&amp;quot;, &amp;quot;Microsoft YaHei&amp;quot;, &amp;quot;Source Han Sans SC&amp;quot;, &amp;quot;Noto Sans CJK SC&amp;quot;, &amp;quot;WenQuanYi Micro Hei&amp;quot;, &amp;quot;MiSans L3&amp;quot;, &amp;quot;Segoe UI&amp;quot;, sans-serif; font-size: medium; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;内存占用更少，计算更快（&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); color: rgb(25, 27, 31); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Helvetica Neue&amp;quot;, &amp;quot;PingFang SC&amp;quot;, &amp;quot;Microsoft YaHei&amp;quot;, &amp;quot;Source Han Sans SC&amp;quot;, &amp;quot;Noto Sans CJK SC&amp;quot;, &amp;quot;WenQuanYi Micro Hei&amp;quot;, &amp;quot;MiSans L3&amp;quot;, &amp;quot;Segoe UI&amp;quot;, sans-serif; font-size: medium; text-align: start;&quot;&gt;硬件优化）&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="350" x="920" y="2120" as="geometry" />
        </mxCell>
        <mxCell id="vpTy94eq_YALo0UENetr-82" edge="1" parent="1" source="vpTy94eq_YALo0UENetr-97" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" target="vpTy94eq_YALo0UENetr-81">
