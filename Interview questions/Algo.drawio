        <mxCell id="Q6r1V7o1WNOOzr6Y5tR7-12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="二分可以理解为处理一下问题的思路&lt;div&gt;1. 顺序中查找&lt;/div&gt;&lt;div&gt;2. 一次排除一半&lt;/div&gt;&lt;div&gt;3. [T, T, T, ...T, F, .., F, F]中查找边界&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="286" x="354" y="320" as="geometry" />
        </mxCell>
        <mxCell id="Q6r1V7o1WNOOzr6Y5tR7-13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="保守移动： l = mid 或者 r = mid&lt;div&gt;保守移动能保证：保住符合条件的边界，但是使用不当可能进入死循环&lt;br&gt;&lt;div&gt;激进移动： l = mid&amp;nbsp; + 1;&lt;/div&gt;&lt;div&gt;避免&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;死循环，给另一边提供保守移动的条件&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="426" x="354" y="400" as="geometry" />
        </mxCell>
        <mxCell id="Q6r1V7o1WNOOzr6Y5tR7-14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="mid = l + (r-l)/2; --- 包左边， 左边就需要激进移动&lt;div&gt;mid = l + (r-l+1)/2; --- 包右边， 右边就需要激进移动&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="326" x="354" y="480" as="geometry" />
        </mxCell>
        <mxCell id="Q6r1V7o1WNOOzr6Y5tR7-15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="能够用stack实现&lt;div&gt;也可以用递归实现&lt;/div&gt;" vertex="1">
