        <mxCell id="IPvgAa_iKYEpdZ_FDVAW-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;color: rgb(22, 22, 22); font-family: &amp;quot;Segoe UI&amp;quot;, &amp;quot;Segoe UI Variable Text&amp;quot;, -apple-system, BlinkMacSystemFont, &amp;quot;Helvetica Neue&amp;quot;, Helvetica, Arial, sans-serif; font-size: 16px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;Microservices are small, independent, and loosely coupled components&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="530" x="380" y="220" as="geometry" />
        </mxCell>
        <mxCell id="IPvgAa_iKYEpdZ_FDVAW-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;color: rgb(22, 22, 22); font-family: &amp;quot;Segoe UI&amp;quot;, &amp;quot;Segoe UI Variable Text&amp;quot;, -apple-system, BlinkMacSystemFont, &amp;quot;Helvetica Neue&amp;quot;, Helvetica, Arial, sans-serif; font-size: 16px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;Each service is self-contained and should implement a single business capability&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="610" x="1000" y="220" as="geometry" />
        </mxCell>
        <mxCell id="IPvgAa_iKYEpdZ_FDVAW-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;color: rgb(22, 22, 22); font-family: &amp;quot;Segoe UI&amp;quot;, &amp;quot;Segoe UI Variable Text&amp;quot;, -apple-system, BlinkMacSystemFont, &amp;quot;Helvetica Neue&amp;quot;, Helvetica, Arial, sans-serif; font-size: 16px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;services can be deployed independently, teams can update existing services without rebuilding or redeploying the entire application.&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="520" x="1000" y="310" as="geometry" />
        </mxCell>
        <mxCell id="IPvgAa_iKYEpdZ_FDVAW-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;color: rgb(22, 22, 22); font-family: &amp;quot;Segoe UI&amp;quot;, &amp;quot;Segoe UI Variable Text&amp;quot;, -apple-system, BlinkMacSystemFont, &amp;quot;Helvetica Neue&amp;quot;, Helvetica, Arial, sans-serif; font-size: 16px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;They communicate through well-defined APIs, which keeps internal implementations hidden from other services&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="450" x="1000" y="400" as="geometry" />
